  create  table "db"."analytics"."servicenow_tickets_cleaned__dbt_tmp"
  
  
    as
  
  (
    WITH cleaned AS (
    SELECT DISTINCT
        inc_number AS ticket_id,
        inc_category AS category,
        inc_priority AS priority,
        TO_TIMESTAMP(inc_sys_created_on, 'MM/DD/YY HH24:MI') AS created_date,
        TO_TIMESTAMP(inc_resolved_at, 'MM/DD/YY HH24:MI') AS resolved_date,
        inc_assignment_group AS assigned_group,
        inc_state AS status,
        inc_assigned_to AS technician,
        inc_close_code AS close_code,
        inc_close_notes AS close_notes
    FROM "your_database_name"."public"."servicenow_tickets_raw"  -- Change ref to source
    WHERE inc_sys_created_on IS NOT NULL
        AND inc_resolved_at IS NOT NULL
        AND inc_number IS NOT NULL
)

SELECT * FROM cleaned;
  );
  
