    as
  
  (
    

WITH cleaned AS (
    SELECT DISTINCT
        inc_number AS ticket_id,
        inc_category AS category,
        inc_priority AS priority,
        inc_sys_created_on AS created_date,
        inc_resolved_at AS resolved_date,
